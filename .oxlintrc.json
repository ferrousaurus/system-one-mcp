{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "preserve-caught-error": "off"
  },
  "ignorePatterns": ["coverage/**", ".vitest/**", "node_modules/**"]
}
