{
  "name": "system-one-mcp",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#ferrousaurus/system-one-mcp/*": "./src/*",
    "#ferrousaurus/system-one-mcp-test/*": "./test/*"
  },
  "scripts": {
    "start": "nub src/index.ts",
    "codegen": "varlock codegen",
    "format": "oxfmt src package.json tsconfig.json vitest.config.ts .oxlintrc.json .oxfmtrc.json .github",
    "format:check": "oxfmt --check src package.json tsconfig.json vitest.config.ts .oxlintrc.json .oxfmtrc.json .github",
    "lint": "oxlint src vitest.config.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "install": "^0.13.0",
    "openai": "^7.28.0",
    "varlock": "^1.21.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.7.5",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "nub@0.7.5"
}
